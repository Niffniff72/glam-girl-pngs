# Copy into your host's environment-variable settings (Vercel → Project → Settings → Environment Variables).
# Never commit real values. Nothing in this app ever prints them.

# Your public site URL, no trailing slash (used for /go/ short links)
SITE_URL=https://glamgirlpngs.com

# Postgres (Neon / Supabase / Vercel Postgres). Use the *pooled* connection string.
DATABASE_URL=

# Meta app → Instagram → "API setup with Instagram login"
IG_APP_SECRET=          # the *Instagram* app secret (used for X-Hub-Signature-256)
IG_ACCESS_TOKEN=        # long-lived token from step 2 of that page (seed — the cron keeps it fresh)
IG_VERIFY_TOKEN=        # any random string you make up; paste the same one into Meta's webhook form

# Optional — fetched from /me automatically if left blank
IG_USER_ID=
IG_USERNAME=
IG_GRAPH_VERSION=v24.0

# Kit → Settings → Developer → API keys (v4)
KIT_API_KEY=

# Random string; Vercel sends it to the weekly token-refresh cron
CRON_SECRET=
