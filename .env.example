# Copy into your host's environment-variable settings
# (Netlify → Site configuration → Environment variables).
# Never commit real values. Nothing in this app ever prints them.

# Your public site URL, no trailing slash (used for /go/ short links).
# On Netlify you can leave this out — it uses your netlify.app address automatically.
SITE_URL=https://glamgirlpngs.com

# Postgres (Neon / Supabase / Vercel Postgres). Use the *pooled* connection string.
DATABASE_URL=

# Meta app → Use cases → Customize → "API setup with Unified login"
IG_ACCESS_TOKEN=        # system-user token ("EAA…", never expires) — or an older "IGAA…" token
IG_USER_ID=             # your Instagram account ID (shown under your username on that page). Required for EAA tokens.
IG_APP_SECRET=          # Unified login: App settings → Basic → App secret. (Older Instagram Login apps: the Instagram app secret.)
IG_VERIFY_TOKEN=        # any random string you make up; paste the same one into Meta's webhook form

# Optional
IG_USERNAME=            # looked up automatically if blank
IG_GRAPH_HOST=          # auto: EAA tokens → graph.facebook.com, IGAA tokens → graph.instagram.com
IG_GRAPH_VERSION=v24.0

# Kit → Settings → Developer → API keys (v4)
KIT_API_KEY=

# Vercel only: random string Vercel sends to the weekly token-refresh cron (not needed on Netlify)
CRON_SECRET=
